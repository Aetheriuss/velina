@page "/auth/discord/login"
@model Roblox.Website.Pages.Auth.DiscordLogin

@{
    Layout = "Shared/_Layout";
}

@section MetaTags {
    <title>Redirecting to Discord…</title>
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-6 offset-md-3">
            <div class="card card-body">
                <p>Redirecting you to Discord to sign in… If nothing happens, <a href="/auth/discord/login">click here</a>.</p>
            </div>
        </div>
    </div>
</div>
