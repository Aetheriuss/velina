# Runtime configuration for the unified Next.js app (Phase 1).
#
# config.json is still fully supported — next.config.js reads it and maps the values
# onto these variables automatically. This file documents the env-var path, used when
# you prefer an env-only deployment OR want to override a single config.json value
# (real env vars always win over config.json).
#
# Copy to .env.local (gitignored) and fill in. Both the Pages Router and the App Router
# read these. NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so
# rebuild after changing them. BACKEND_* are server-only secrets and are never exposed
# to the client.

# --- Public (was publicRuntimeConfig.backend) ---
# Site origin. Used by the legacy proxy's SSRF allow-list and set-cookie rewriting.
NEXT_PUBLIC_BASE_URL=https://velina.lol
# Template for apisite URLs: {0}=subdomain, {1}=path.
NEXT_PUBLIC_API_FORMAT=https://velina.lol/apisite/{0}{1}
# Enable the pages/api/proxy.js indirection. "false" to disable; anything else enables.
NEXT_PUBLIC_PROXY_ENABLED=true
# Feature flags as a JSON object (see util/create_config.js for the full set).
NEXT_PUBLIC_FLAGS={"myAccountPage2016Enabled":true,"catalogGenreFilterSupported":true,"catalogPageLimit":28,"catalogSaleCountVisibleFromDetailsEndpoint":true,"catalogDetailsPageResellerLimit":10,"avatarPageInventoryLimit":10}

# --- Server-only secrets (was serverRuntimeConfig.backend) ---
# Stable signing key for the login CSRF JWT. Generate once, keep secret.
BACKEND_CSRF_KEY=
# Optional internal authorization secret forwarded to the backend (server-to-server).
BACKEND_AUTHORIZATION=
# Header name for the secret above (defaults to "authorization").
BACKEND_AUTHORIZATION_HEADER=
