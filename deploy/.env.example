# Copy to repo-root .env (gitignored) and fill in. Values come from deploy/generate-secrets.sh.
# docker compose -f docker-compose.prod.yml reads this automatically.

# --- Postgres ---
POSTGRES_USER=velina
POSTGRES_DB=velina
POSTGRES_PASSWORD=CHANGE_ME

# --- Asset validator (must equal backend appsettings AssetValidation:Authorization) ---
ASSET_VALIDATION_AUTHORIZATION=CHANGE_ME

# --- Host paths bind-mounted into the backend ---
# Restricted config dir (mode 0600): holds appsettings.json, game-servers.json, cloudflared/.
VELINA_CONFIG_DIR=/mnt/user/appdata/velina/config
# Persistent data/content dir: appsettings Directories:* point under here (e.g. /data/assets).
VELINA_DATA_DIR=/mnt/user/appdata/velina/data
