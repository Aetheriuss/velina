# Copy to repo-root .env (gitignored) and fill in. Values come from deploy/generate-secrets.sh.
# docker compose -f docker-compose.prod.yml reads this automatically.

# --- Container images (registry to pull from / push to) ---
# GHCR (recommended — "from GitHub"). MUST be lowercase. Used by deploy/build-and-push.sh and on Unraid.
VELINA_REGISTRY=ghcr.io/aetheriuss
VELINA_TAG=latest

# --- Postgres ---
POSTGRES_USER=velina
POSTGRES_DB=velina
POSTGRES_PASSWORD=CHANGE_ME

# --- Asset validator (must equal backend appsettings AssetValidation:Authorization) ---
ASSET_VALIDATION_AUTHORIZATION=CHANGE_ME

# --- Game-server LAN callback (Phase 4 Windows VM only; see DEPLOYMENT_GUIDE §7) ---
# Host LAN IP of the Unraid box. Publishes backend :5000 on this IP ONLY so the VM's game-server can
# reach /gs/* + thumbnail-upload callbacks. Leave unset (defaults to 127.0.0.1 = loopback only) if you
# have no Windows VM. Never set this to 0.0.0.0 — public ingress must stay exclusively through cloudflared.
# BACKEND_LAN_IP=192.168.1.50

# --- Host paths bind-mounted into the backend ---
# Restricted config dir (mode 0600): holds appsettings.json, game-servers.json, cloudflared/.
VELINA_CONFIG_DIR=/mnt/user/appdata/velina/config
# Persistent data/content dir: appsettings Directories:* point under here (e.g. /data/assets).
VELINA_DATA_DIR=/mnt/user/appdata/velina/data
